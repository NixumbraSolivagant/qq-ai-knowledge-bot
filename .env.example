DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=3001

# OneBot V11 access token; leave empty if NapCat uses no token
ONEBOT_ACCESS_TOKEN=
ONEBOT_SECRET=

# Comma-separated QQ group IDs
KNOWLEDGE_GROUP_IDS=123456789

# Daily random push window: 08:00–18:00
KNOWLEDGE_TOPICS=机器学习、深度学习、大语言模型、AI智能体、机器人、AI产品、开源生态、芯片算力、行业应用、版权隐私、AI安全与伦理、AI职业发展
CHAT_COOLDOWN_SECONDS=8
SOURCE_CACHE_SECONDS=21600
SOURCE_TIMEOUT_SECONDS=6

# Volcengine Ark Responses API
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-mini-260215
ARK_TIMEOUT_SECONDS=30
